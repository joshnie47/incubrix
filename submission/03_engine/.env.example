# IncuBrix Content Engine — Environment Configuration Template
# Copy this file to .env and configure your keys (DO NOT COMMIT SENSITIVE KEYS)

# LLM Provider Configuration (Optional — Engine functions in 100% offline rule-synthesis mode without keys)
LLM_PROVIDER=offline_mock
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_claude_api_key_here

# Engine Tuning Parameters
ENGINE_LOG_LEVEL=INFO
DEDUP_DB_PATH=submission/03_engine/state/engine_state.db
DEFAULT_OUTPUT_DIR=submission/02_main_output
